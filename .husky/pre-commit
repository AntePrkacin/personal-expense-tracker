#!/bin/bash

set -euo pipefail

# Staged paths (Added/Copied/Modified/Renamed).
CHANGED="$(git diff --cached --name-only --diff-filter=ACMR)"

# Lint + format staged files (per-app config, see .lintstagedrc.js).
npx lint-staged

# Reminder only - backend unit tests are not run automatically here (they can be
# slow). The `backend` job in .github/workflows/ci.yml runs lint, build, unit
# tests and e2e on every PR. Run them locally if you like.
#
# The deploy reminder is a nudge, not a gate, and PET-86 inverted what it says.
# It used to read "main does not auto-deploy" and name a manual dispatch, which
# was true on Fly. A Cloud Build trigger now builds and deploys this backend on
# every push to main, so the risk ran the other way round the moment the platform
# changed: the danger is no longer forgetting to deploy, it is merging something
# that deploys itself before its configuration exists. See backend/CLAUDE.md.
if echo "$CHANGED" | grep -q '^backend/'; then
  echo "ℹ️  backend/ files changed - consider running: cd backend && npm test"
  echo "⚠️  backend/ changed - merging to main DEPLOYS it automatically. Set any new config on Cloud Run first."
fi
