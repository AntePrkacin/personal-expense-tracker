%% Deployment and infrastructure: five hosted services and one API key.
%% Three things on it are decisions rather than topology:
%%   - the frontend is the only caller of the API, which is what lets the HTTP
%%     contract be generated from the backend and committed
%%   - main DOES auto-deploy the backend: a Cloud Build trigger builds and
%%     deploys every push, so deploying is merging
%%   - the instance's /tmp holds sync replicas, not the source of truth, and
%%     the service is capped at one instance because of it
flowchart TB
    subgraph client["Browser"]
        B["spendifico.vercel.app"]
    end

    subgraph vercel["Vercel"]
        FE["Next.js frontend<br/>App Router, port 4200 in dev"]
    end

    subgraph gcp["Google Cloud, europe-west1"]
        API["NestJS API on Cloud Run<br/>service expenso, max-instances=1"]
        TMP[("/tmp<br/>ephemeral sync replicas")]
        CB["Cloud Build trigger<br/>on every push to main"]
    end

    subgraph turso["Turso Cloud"]
        CDB[("expanso<br/>central directory")]
        UDB[("expenso-user-UUID<br/>one per account")]
    end

    GEM["Google Gemini<br/>receipt scanning + assistant"]

    subgraph ci["GitHub Actions"]
        CI["ci.yml<br/>on every PR"]
    end

    B --> FE
    FE -->|"the only caller"| API
    API --> CDB
    API --> UDB
    API --- TMP
    API -->|"scan + chat"| GEM
    CB -->|"builds backend/Dockerfile, deploys"| API
    CI -.->|"gates the merge"| CB
