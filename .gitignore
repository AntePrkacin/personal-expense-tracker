# Dependencies
node_modules/

# Build outputs
dist/
build/
.next/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.local

# Local database files (SQLite/Turso). The committed migrations under
# backend/drizzle/ recreate them; nothing here is a source of truth.
backend/databases/

# Local / secret config — commit only the *.example variants
.mcp.json
.claude/settings.local.json

# Drizzle's own agent skills, installed by `npm run skills` from the drizzle-kit
# in backend/node_modules. Generated rather than committed on purpose: they are
# version-matched to the installed drizzle-kit, so a vendored copy would drift
# the moment it is bumped. The installer also symlinks .claude/skills/drizzle*
# into .agents/, and committed symlinks break on Windows without Developer Mode.
.agents/
skills-lock.json
.claude/skills/drizzle
.claude/skills/drizzle-*

# Logs
*.log
npm-debug.log*
