# Base URL of the NestJS backend API this frontend calls.
# Read server-side only (src/lib/backend.ts, which every access write goes through),
# so it has NO NEXT_PUBLIC_ prefix and is never inlined into the browser bundle.
# Never expose secrets via NEXT_PUBLIC_ vars; real secrets live in the team
# secret manager and, for Vercel, in the project's Environment Variables settings.
BACKEND_URL=http://localhost:3000

# What this app presents to the backend to reach POST /api/demo/session. The backend
# requires it whenever DEMO_ENABLED is true and answers 404 without it, so the two sides
# must carry the same value. Server-side only, hence no NEXT_PUBLIC_ prefix: a secret with
# that prefix is inlined into the browser bundle and is public forever. Unset locally is
# fine as long as the backend has the demo off. Generate one with `openssl rand -base64 32`.
# DEMO_SHARED_SECRET=
