{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev -p 4200",
    "build": "next build",
    "start": "next start -p 4200",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "api:types": "openapi-typescript ../backend/openapi.json -o src/types/api.d.ts",
