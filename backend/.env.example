# Backend (NestJS) configuration.
#
# Copy this file to .env and adjust as needed:
#     cp .env.example .env
#
# .env is gitignored and must never be committed. Only this template is.
# Values are read via ConfigService (see src/main.ts); anything set in your
# shell environment overrides what is written here.

# Port the API listens on. The frontend expects 3000 by default.
PORT=3000

# Origin allowed by CORS - the Next.js dev server.
# Only needed for client-side fetches; Server Components don't use CORS.
FRONTEND_URL=http://localhost:4200

# IANA zone the budgeting period is resolved in. One server-wide zone, not UTC
# and not per user: UTC rolls the period over at the wrong local moment on the
# boundary day. A per-user timezone is the eventual fix (docs/TODO.md).
APP_TIMEZONE=Europe/Zagreb

# Directory holding the local database files (gitignored). In cloud mode these
# are the synced local copies rather than the only copy.
DATABASE_DIR=./databases

# Turso Cloud (new sync engine). Set the four required vars ALL or NONE.
# Without them the backend runs on plain local files (CI and e2e do this).
# One group, decode-pet, holds the central database and every per-user one.
# The backend creates the per-user databases itself at registration.
# One-time setup. --tursodb is REQUIRED: it selects the Turso engine, which is
# what @tursodatabase/sync replicates against. Without it you silently get a
# libSQL database, and the engine cannot be changed after creation.
#   turso group create decode-pet
#   turso db create spendifico-app --group decode-pet --tursodb
# TURSO_ORG=                         # organization slug
# Every token below is created with Expires: NEVER (MVP decision; rotate manually).
# TURSO_ORG_TOKEN=                   # control-plane token: create/delete user databases,
#                                    # mint their tokens. Scope it to the group rather
#                                    # than the whole organization:
#                                    #   turso auth api-tokens mint spendifico-backend \
#                                    #     --org <your-org-slug> --group decode-pet \
#                                    #     --scope db:create --scope db:delete \
#                                    #     --scope db:mint-token
#                                    # --org is mandatory alongside --group; without
#                                    # it the CLI refuses rather than assuming one.
# TURSO_CENTRAL_DB_URL=              # turso db show spendifico-app --url
# TURSO_CENTRAL_DB_TOKEN=            # turso db tokens create spendifico-app
# Optional break-glass token for manual CLI/Studio access; the app never uses it:
# TURSO_GROUP_TOKEN=                 # turso group tokens create decode-pet
# TURSO_GROUP=decode-pet
# TURSO_SYNC_INTERVAL_S=60

# Outbound mail, over MailPace's HTTP API (not SMTP - port 25 is blocked in most
# production environments). Set BOTH or NEITHER: unset means login links are
# written to the log instead of emailed, which is what local development and the
# e2e suite use, and is why the backend still runs with no .env at all.
# MailPace setup, once: add the domain, complete the DKIM authorization it asks
# for, then create a server and copy its API token. MAIL_FROM must be an address
# on that authorized domain or every send is rejected.
#
# This project's sender is recorded below, but BOTH lines stay commented: this
# file is copied verbatim by `cp .env.example .env`, and MAIL_FROM without
# MAILPACE_API_TOKEN fails at boot with "contains [MAIL_FROM] without its
# required peers" - the pairing working as designed. Uncomment both once you
# have a token, never just one.
# MAILPACE_API_TOKEN=                # server token from the MailPace dashboard
# MAIL_FROM=login@spendifico.eu      # this project's authorized sender. Mail
#                                    # sent to it is forwarded to
#                                    # spendifico@gmail.com, the project's
#                                    # official inbox and the address to smoke
#                                    # test against - never a personal one.
#
# Display name on the sender, giving "Spendifico" <login@spendifico.eu>. Kept
# separate from MAIL_FROM so that stays a bare, validated address. Optional and
# unpaired: without it the sender is just the address.
# MAIL_FROM_NAME=Spendifico

# How long an emailed login link stays valid, in minutes. Single use either way.
# LOGIN_LINK_TTL_M=15

# How long a session lasts once a link is verified, in days. Fixed expiry, not
# sliding: it is never extended by use, and re-login is one email click. There is
# no logout endpoint, so revocation means tombstoning the row by hand.
# SESSION_TTL_D=30

# Rate limits on POST /api/auth/register and /api/auth/login-link: two
# independent limiters, and a request is refused when either is over. One is
# keyed on the submitted address (caps mail to one inbox, whoever asks), one on
# the caller's IP (caps one host walking many addresses) - a single combined
# IP+email key would stop neither, since every new pair gets a fresh bucket.
# In-memory, so the limits are per backend instance.
# AUTH_RATE_LIMIT=5                  # per window, per submitted address
# AUTH_RATE_IP_LIMIT=30              # per window, per caller IP. Laxer: one NAT
#                                    # can hide a whole classroom
# AUTH_RATE_TTL_S=900                # window length in seconds, shared by both

# Google AI Studio API key for receipt-scanning extraction. Optional and
# unpaired: without it POST /api/transactions/scan answers 503 rather than
# failing to boot, which is what lets CI and the e2e suite run with no key.
# Get one at https://aistudio.google.com/apikey - free tier, no card, and no
# Cloud project to create. docs/guides/configuration.md walks the whole step.
# Uncomment it only once you have a key: an empty value is not "unset", it is
# an empty string, which the Joi schema rejects at boot.
# GEMINI_API_KEY=                    # key from https://aistudio.google.com/apikey

# Rate limit on POST /api/transactions/scan, per signed-in user rather than
# per IP - it protects this project's shared Gemini quota.
# SCAN_RATE_LIMIT=10                 # scans per window, per session user
# SCAN_RATE_TTL_S=3600               # window length in seconds

# How many reverse proxies sit in front of the app. 0 means none, which is right
# locally, in CI and in the e2e suite: the per-IP limiter above then keys on the
# real socket address. Raise it only where something genuinely proxies to this
# process, one per hop - the Fly deployment sets 1. Both mistakes are silent:
# leaving it at 0 behind a proxy makes AUTH_RATE_IP_LIMIT a global cap, because
# every caller looks like the proxy; setting it with nothing in front lets a
# client send its own X-Forwarded-For and pick a fresh bucket per request.
# TRUST_PROXY_HOPS=0
